# ==============================================================================
# Facebook Public Content Search - Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# ONLY variables prefixed with "NEXT_PUBLIC_" are bundled and exposed to the browser.
# All other variables (including service-role keys and provider credentials) are
# strictly server-only and NEVER exposed to frontend clients.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Authentication & PostgreSQL Database)
# ------------------------------------------------------------------------------

# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous Key (safe for browser distribution)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for administrative backend jobs, RLS-bypassing migrations, and system telemetry
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Production Application Base URL (for email auth confirmations and OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ------------------------------------------------------------------------------
# Multi-Provider Search Credentials (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------

# Tavily Search API (Primary discovery provider - Free Tier: 1,000 monthly credits)
# Obtain a free key at: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-placeholder

# Brave Search API (Secondary discovery provider - Free Budget: $5.00 monthly)
# Both BRAVE_API_KEY and BRAVE_SEARCH_API_KEY are supported
# Obtain an API key at: https://brave.com/search/api/
BRAVE_API_KEY=your-brave-api-key-placeholder
BRAVE_SEARCH_API_KEY=your-brave-api-key-placeholder

# Meta Graph API Connector (Optional - conditional on approved Page access)
# Both META_ACCESS_TOKEN and META_PAGE_ACCESS_TOKEN are supported
# Generate a Page Access Token at: https://developers.facebook.com/tools/explorer/
META_APP_ID=your-meta-app-id-placeholder
META_APP_SECRET=your-meta-app-secret-placeholder
META_ACCESS_TOKEN=your-meta-access-token-placeholder
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token-placeholder
META_GRAPH_API_VERSION=v21.0
